# harness/field/baseline.env: the snapshot each lab VM is reset to before a scenario's leg, and the realm
# those snapshots carry. Sourced by run.sh (preflight: every snapshot named here must exist) and the scenarios.
# Snapshots are taken by hand (lab.sh snapshot); a field run never creates or deletes one.

# The rust baseline: the kerber-rust realm KERBER.TEST on the Fedora 44 disks.
#   kdc       rust-field-p12-f44  as f4-mit-f44, the kerber-rust realm; boots serving
#   client1   rust-nfs-sso-f44    as mit-sudo-fc44, joined to the kerber-rust realm
#   client2   rust-ssh-f44        as mit-kit-fc44, joined to the kerber-rust realm
#   services  services-rust-f44   as f4-mit-f44, Ganesha and Keycloak from that realm
#   kdc2      rust-replica-f44    as f4-mit-f44, kerber-rust's programs, no realm
# field.env is sourced first and may set any MIT_SNAPSHOT_* or RUST_SNAPSHOT_*. The default stays.
RUST_SNAPSHOT_KDC=${RUST_SNAPSHOT_KDC:-rust-field-p12-f44}
RUST_SNAPSHOT_CLIENT1=${RUST_SNAPSHOT_CLIENT1:-rust-nfs-sso-f44}
RUST_SNAPSHOT_CLIENT2=${RUST_SNAPSHOT_CLIENT2:-rust-ssh-f44}
RUST_SNAPSHOT_SERVICES=${RUST_SNAPSHOT_SERVICES:-services-rust-f44}
RUST_SNAPSHOT_KDC2=${RUST_SNAPSHOT_KDC2:-rust-replica-f44}
RUST_REALM=KERBER.TEST
# The realm's passwords: file names under ~/kerber-lab/secrets (never values).
RUST_SECRET_ALICE=rust-realm.alice.password
RUST_SECRET_BOB=rust-realm.bob.password
RUST_SECRET_BOB_TEMP=rust-realm.bob-up1-temp.password
RUST_SECRET_ADMIN=rust-realm.admin-admin.password
RUST_SECRET_ALICE_TEMP=rust-realm.alice-changed.password
RUST_SECRET_MASTER=rust-realm.master.password
# user@KERBER.TEST, whom the AD DC maps to its kbruser (ad-trust).
RUST_SECRET_KUSER=rust-realm.user.password

# The MIT baseline, the oracle: Fedora 44's krb5-server 1.22.2 realm KERBER.TEST.
#   kdc       f4-mit-f44     the MIT realm; boots serving
#   client1   mit-sudo-fc44  the kit-joined client, NFS + SSO
#   client2   mit-kit-fc44   the kit-joined client, MIT krb5-workstation
#   services  f4-mit-f44     Ganesha and Keycloak keyed from the MIT realm
#   kdc2      f4-mit-f44     the replica VM: Fedora's krb5-server 1.22.2, no realm
MIT_SNAPSHOT_KDC=${MIT_SNAPSHOT_KDC:-f4-mit-f44}
MIT_SNAPSHOT_CLIENT1=${MIT_SNAPSHOT_CLIENT1:-mit-sudo-fc44}
MIT_SNAPSHOT_CLIENT2=${MIT_SNAPSHOT_CLIENT2:-mit-kit-fc44}
MIT_SNAPSHOT_SERVICES=${MIT_SNAPSHOT_SERVICES:-f4-mit-f44}
MIT_SNAPSHOT_KDC2=${MIT_SNAPSHOT_KDC2:-f4-mit-f44}
MIT_REALM=KERBER.TEST
MIT_SECRET_ALICE=mit-realm.alice.password
MIT_SECRET_BOB=mit-realm.bob.password
MIT_SECRET_ADMIN=mit-realm.admin-admin.password
MIT_SECRET_ALICE_TEMP=mit-realm.alice-changed.password
MIT_SECRET_MASTER=mit-realm.master-password
MIT_SECRET_KUSER=mit-realm.user.password

# Shared by both legs: lldap's admin (lldap_disabled), Keycloak's master-realm admin (the events, read-only), the
# lab CA (public; the probes trust it).
LAB_SECRET_LLDAP_ADMIN=ldap/lldap-admin.password
LAB_SECRET_KEYCLOAK_ADMIN=s2/keycloak-keyadmin.password
LAB_CA=ldap/lab-ca.crt
