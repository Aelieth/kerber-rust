# harness/field/baseline.env: the snapshot each lab VM is reset to before a scenario's leg, and the realm
# those snapshots carry. Sourced by run.sh (preflight: every snapshot named here must exist) and the scenarios.
# Snapshots are taken by hand (lab.sh snapshot); a field run never creates or deletes one.

# The rust baseline: the kerber-rust realm KERBER.TEST after the hand records R1 to R6 and UP1.
#   kdc       rust-field-p12  kerber-rust installed (PREFIX=/usr) with the field realm; boots serving
#   client1   rust-nfs-sso    the kit-joined Kinoite client, NFS + SSO set up
#   client2   rust-ssh        the kit-joined Fedora client, MIT 1.22.2 krb5-workstation, sshd target
#   services  services-rust   Ganesha and Keycloak keyed from the kerber-rust realm
RUST_SNAPSHOT_KDC=rust-field-p12
RUST_SNAPSHOT_CLIENT1=rust-nfs-sso
RUST_SNAPSHOT_CLIENT2=rust-ssh
RUST_SNAPSHOT_SERVICES=services-rust
RUST_REALM=KERBER.TEST
# The realm's passwords: file names under ~/kerber-lab/secrets (never values).
RUST_SECRET_ALICE=rust-realm.alice.password
RUST_SECRET_BOB=rust-realm.bob.password
RUST_SECRET_BOB_TEMP=rust-realm.bob-up1-temp.password
RUST_SECRET_ADMIN=rust-realm.admin-admin.password

# The MIT baseline, the oracle: Fedora's krb5-server 1.22.2 realm KERBER.TEST, set f4-mit, taken 2026-10-02 by the F4
# plan's item-0 hand fix (record ~/kerber-lab/runs/hand-f4-mit-20261002T143502Z/). kdc's mit-trust-ra and client2's
# mit-nfs disagreed on host/client2's keys; R4-MIT's join step was re-run on client2, every keytab on the four VMs
# then equalled the KDC's (kvno and enctypes), and NFS, SPNEGO and ssh from client2 worked before the snapshots.
#   kdc       f4-mit  mit-trust-ra + client2's join (host/client2 kvno 2, host/client2.kerber.test kvno 3); boots serving
#   client1   f4-mit  = mit-nfs-sso: the kit-joined Kinoite client, NFS + SSO set up
#   client2   f4-mit  mit-nfs re-joined: the kit's lab copy, NFS, check_spnego, MIT krb5-workstation
#   services  f4-mit  = services-up: Ganesha and Keycloak keyed from the MIT realm, lldap
MIT_SNAPSHOT_KDC=f4-mit
MIT_SNAPSHOT_CLIENT1=f4-mit
MIT_SNAPSHOT_CLIENT2=f4-mit
MIT_SNAPSHOT_SERVICES=f4-mit
MIT_REALM=KERBER.TEST
MIT_SECRET_ALICE=mit-realm.alice.password
MIT_SECRET_BOB=mit-realm.bob.password
MIT_SECRET_ADMIN=mit-realm.admin-admin.password
