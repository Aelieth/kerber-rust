# harness/field/ds/rocky10.env: DS on Rocky Linux 10, sourced before run.sh: --profile kill-loop with this file alone,
# --profile ds with rocky10r.env after it. The snapshots are harness/hand/ds-baselines.sh's.
export FIELD_ROLE_KDC=rocky10
export FIELD_KDC_FAMILY=rocky
export KDC_BASE_SNAPSHOT=ds-base-rocky10
export MIT_SNAPSHOT_KDC=mit-oracle-rocky10
export RUST_SNAPSHOT_KDC=rust-base-rocky10
# Rocky's MIT is krb5-server-1.21.3-10.el10_2: 1.21's rows (A1c's bind, KA.keep.self), but its PKINIT
# offers EC groups as 1.22's does, so pkinit.sh's group row takes the knob.
export FIELD_MIT_VERSION=1.21
export FIELD_MIT_PKINIT_EC=yes
