#cloud-config
# ub26.kerber.test: Ubuntu 26.04 for the CI mirror. The base snapshot is
# this image, updated. The toolchain snapshot is taken later.
#
# lab.sh renders this template into ~/kerber-lab/seeds (outside git):
#   @SSH_PUBKEY@        the lab public key, ~/kerber-lab/ssh/lab_ed25519.pub
#   @LAB_PASSWD_HASH@   SHA-512 crypt of the console password, ~/kerber-lab/secrets
hostname: ub26
fqdn: ub26.kerber.test
prefer_fqdn_over_hostname: true
manage_etc_hosts: false
timezone: UTC
users:
  - name: lab
    gecos: kerber-lab operator
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: false
    passwd: "@LAB_PASSWD_HASH@"
    ssh_authorized_keys:
      - "@SSH_PUBKEY@"
disable_root: true
ssh_pwauth: false
package_upgrade: true
packages:
  - chrony
  - qemu-guest-agent
  - tcpdump
  - jq
  - bind9-dnsutils
  - tar
  - rsync
runcmd:
  # qemu-guest-agent.service is static on Ubuntu 26.04: enable fails it.
  - [systemctl, enable, --now, chrony.service]
  - [systemctl, start, qemu-guest-agent.service]
