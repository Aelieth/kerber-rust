# Resource caps for the C1 multi-host prod realm — sourced by env-up.sh / the
# future prod-realm-gate.sh. Sized for a 64 GB / many-core host: generous
# per-node headroom, plus a hard ceiling so a runaway container can't eat the box.
#
# Reality check: a Rust KDC/kpropd or an MIT client uses well under ~150 MB RSS;
# 1g is ~7x headroom. A full Samba AD DC is heavier (~300-500 MB running). Even
# the whole matrix at once (3 prod nodes + 2 Samba DCs) caps at ~7 GB / 10 CPU —
# a small fraction of a 64 GB / 32-core host, leaving >50 GB and >20 cores free.
#
# Every value is overridable from the environment.

# Network + image + realm.
KERBER_PROD_NET="${KERBER_PROD_NET:-kerber-rust-prod}"
KERBER_PROD_IMAGE="${KERBER_PROD_IMAGE:-kerber-rust-prod-node:latest}"
# Falls back to the lean base image if the capture-tooling node image is absent.
KERBER_PROD_IMAGE_FALLBACK="${KERBER_PROD_IMAGE_FALLBACK:-kerber-rust-mit-kdc:1.22.2}"
# Named prod realm (S1b `krb5-kdb create`; not `--test-realm` KERBER.TEST).
KERBER_PROD_REALM="${KERBER_PROD_REALM:-PROD.KERBER.TEST}"

# Per-node caps — KDC primary / replica / MIT client.
KERBER_KDC_MEM="${KERBER_KDC_MEM:-1g}"
KERBER_KDC_CPUS="${KERBER_KDC_CPUS:-2}"

# Samba AD DC nodes (the AD-interop oracle) run a full DC — give them more.
KERBER_SAMBA_MEM="${KERBER_SAMBA_MEM:-2g}"
KERBER_SAMBA_CPUS="${KERBER_SAMBA_CPUS:-2}"

# Safety ceiling: env-up refuses to launch past this many kerber-rust containers.
KERBER_PROD_MAX_NODES="${KERBER_PROD_MAX_NODES:-8}"

# Shared master password for the realm DB + kprop wrap (throwaway, test-only).
KERBER_PROD_MASTER_PW="${KERBER_PROD_MASTER_PW:-masterpassword}"
KERBER_PROD_USER_PW="${KERBER_PROD_USER_PW:-userpassword}"
KERBER_PROD_ADMIN_PW="${KERBER_PROD_ADMIN_PW:-adminpassword}"
