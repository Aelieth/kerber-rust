# kerber-rust: Fedora krb5-server's krb5kdc.service, with make install's paths.
[Unit]
Description=Kerberos 5 KDC
Wants=network-online.target
After=syslog.target network.target network-online.target

[Service]
Type=forking
PIDFile=/run/krb5kdc.pid
EnvironmentFile=-@SYSCONFIGDIR@/krb5kdc
ExecStart=@SBINDIR@/krb5kdc -P /run/krb5kdc.pid $KRB5KDC_ARGS
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
