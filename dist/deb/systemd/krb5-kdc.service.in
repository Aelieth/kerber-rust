# kerber-rust: Debian krb5-kdc's krb5-kdc.service, with make install's paths.
[Unit]
Description=Kerberos 5 Key Distribution Center


[Service]
Type=forking
PIDFile=/run/krb5-kdc.pid
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=-@SYSCONFIGDIR@/krb5-kdc
ExecStart=@SBINDIR@/krb5kdc -P /var/run/krb5-kdc.pid $DAEMON_ARGS
InaccessibleDirectories=-/etc/ssh -/etc/ssl/private  /root
ReadOnlyDirectories=/
ReadWriteDirectories=-/var/tmp /tmp @KDCDATADIR@ -/var/run /run
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-abnormal
ProtectProc=invisible
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes


[Install]
WantedBy=multi-user.target
