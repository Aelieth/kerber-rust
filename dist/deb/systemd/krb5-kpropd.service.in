# kerber-rust: Debian krb5-kpropd's krb5-kpropd.service, with make install's paths.
[Unit]
Description=Kerberos 5 slave KDC update server
Conflicts=krb5-admin-server.service
After=network.target
[Service]
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=-@SYSCONFIGDIR@/krb5-kpropd
ExecStart=@SBINDIR@/kpropd -D $DAEMON_ARGS
InaccessibleDirectories=-/etc/ssh -/etc/ssl/private  /root
ReadOnlyDirectories=/
ReadWriteDirectories=/var/tmp /tmp @KDCDATADIR@ /var/run /run
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectProc=invisible
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
