# kerber-rust: Debian krb5-kdc's kdc.conf template. Put your realm in place of EXAMPLE.COM
# here (docs/install.md in the kerber-rust tree).
[kdcdefaults]
    kdc_ports = 750,88

[realms]
    EXAMPLE.COM = {
        database_name = @KDCDATADIR@/principal
        admin_keytab = FILE:@KDCDIR@/kadm5.keytab
        acl_file = @KDCDIR@/kadm5.acl
        key_stash_file = @KDCDIR@/stash
        kdc_ports = 750,88
        max_life = 10h 0m 0s
        max_renewable_life = 7d 0h 0m 0s
        #master_key_type = aes256-cts
        #supported_enctypes = aes256-cts:normal aes128-cts:normal
        default_principal_flags = +preauth
    }
